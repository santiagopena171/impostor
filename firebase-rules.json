{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": true
      }
    },
    "savedMatches": {
      "$matchId": {
        ".read": "auth != null && (data.child('savedBy').val() === auth.uid || data.child('playerUids').child(auth.uid).exists())",
        ".write": "auth != null && (data.child('savedBy').val() === auth.uid || !data.exists())"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
